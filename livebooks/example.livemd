# resvg_elixir examples

These examples use the first published `resvg_elixir` release. For development
before publication, follow [Contributing](../CONTRIBUTING.md).

```elixir
Mix.install([
  {:resvg_elixir, "~> 0.1.0"},
  {:req, "~> 0.5"},
  {:kino, "~> 0.9"}
])
```

## Helpers & Glob

```elixir
defmodule H do
  def kino_image_from_png(png) do
    Kino.Image.new(png, :png)
  end

  def download!(url) do
    %{body: body} = Req.get!(url)
    body
  end

  def download_as!(url, path) do
    %{body: body} = Req.get!(url)
    File.write!(path, body)
  end
end

path = __DIR__
```

## Convert a svg to png

```elixir
rustacean_svg =
  H.download!(
    "https://raw.githubusercontent.com/Cees-Kettenis/resvg_elixir/resvg_elixir-v0.1.0/test/support/rustacean.svg"
  )

{:ok, png} = ResvgElixir.svg_string_to_png_binary(rustacean_svg, resources_dir: path)
H.kino_image_from_png(png)
```

## Set a background color

```elixir
{:ok, png} =
  ResvgElixir.svg_string_to_png_binary(rustacean_svg, background: "gold", resources_dir: path)

H.kino_image_from_png(png)
```

## Use a custom font

```elixir
# Download roboto.ttf
roboto_path = "#{path}/roboto.ttf"

font_file =
  H.download_as!(
    "https://raw.githubusercontent.com/Cees-Kettenis/resvg_elixir/resvg_elixir-v0.1.0/test/support/fonts/Roboto-Regular.ttf",
    roboto_path
  )

svg_string = """
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 150">
    <style type="text/css">
      #text {
        fill: black;
        font-family: 'Roboto';
        font-size: 45px;
        text-anchor: middle;
      }
    </style>
    <text x="50%" y="50%" id="text">Roboto</text>
  </svg>
"""

{:ok, png} =
  ResvgElixir.svg_string_to_png_binary(svg_string, resources_dir: path, font_files: [roboto_path])

H.kino_image_from_png(png)
```

## Composition with svg <image> and :resources_dir

```elixir
H.download_as!(
  "https://raw.githubusercontent.com/Cees-Kettenis/resvg_elixir/resvg_elixir-v0.1.0/test/support/snapshots/rustacean.png",
  "#{path}/rustacean.png"
)

svg_string = """
  <svg xmlns="http://www.w3.org/2000/svg" width="400" height="200"
    xmlns:xlink="http://www.w3.org/1999/xlink"
  >
    <image xlink:href="rustacean.png" width="200" height="200" />
    <image xlink:href="rustacean.png" x="200" width="200" height="200" />
  </svg>
"""

{:ok, png} =
  ResvgElixir.svg_string_to_png_binary(svg_string, resources_dir: path, font_files: [roboto_path])

H.kino_image_from_png(png)
```

## Clip path

```elixir
svg_string = """
  <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"
    xmlns:xlink="http://www.w3.org/1999/xlink"
  >
    <defs>
      <clipPath id="clip-circle">
        <circle cx="100" cy="100" r="100" fill="#FFFFFF" />
      </clipPath>
    </defs>
    <image xlink:href="rustacean.png" width="200" height="200" clip-path="url(#clip-circle)" />
  </svg>
"""

{:ok, png} =
  ResvgElixir.svg_string_to_png_binary(svg_string, resources_dir: path, font_files: [roboto_path])

H.kino_image_from_png(png)
```
